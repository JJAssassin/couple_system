# 情侣小世界 —— HTTPS 反代层（Caddy）
#
# 作用：在现有 docker-compose 的 frontend(nginx:80) 之前加一层 Caddy，
#       把 80/443 流量反代到 frontend:80，从而对外提供 HTTPS。
#       前端 nginx 已负责 /api /uploads /hub → backend:5199，故 Caddy 只需透传。
#
# 两种模式（二选一）：
#
# ① 默认：静态自签证书（certs/localhost.crt，SAN=localhost,127.0.0.1）
#    - 本地即可用 HTTPS，但浏览器会提示“证书不受信任”（可继续访问）。
#    - 适合本地/内网测试，无需域名、无需公网端口。
#    - 证书用 openssl 生成，有效期 365 天，到期重跑生成命令即可：
#      openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/localhost.key \
#        -out certs/localhost.crt -days 365 -subj "/CN=localhost" \
#        -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
#
# ② 正式域名：可信证书（Let's Encrypt，自动续期）
#    - 把下面 `:443` 的站点地址改成你的域名，如 `love.example.com:443`
#    - 删除 `tls /certs/...` 两行，改为 `tls internal`（或留空由 Caddy 自动申请）
#    - 前置条件：域名 DNS A 记录指向本机公网 IP，且本机 80/443 可从公网访问
#    - 建议在本文件顶部 { } 块里填 email（用于证书到期通知）

{
	# email you@example.com        # ② 真域名模式建议填写，用于 Let's Encrypt 通知
}

# HTTPS 入口（自签默认：静态证书，SAN 含 localhost/127.0.0.1）
:443 {
	tls /certs/localhost.crt /certs/localhost.key
	reverse_proxy frontend:80
}

# HTTP 入口：自签模式下也可直连；② 真域名模式下保留，用于 ACME http-01 挑战
:80 {
	reverse_proxy frontend:80
}
