{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySql": "Server=127.0.0.1;Port=3306;Database=couple_love;User=app;Password=<YOUR_MYSQL_APP_PASSWORD>;CharSet=utf8mb4;"
  },
  "Jwt": {
    "AccessExpireMinutes": 120,
    "RefreshExpireDays": 7,
    "Issuer": "CoupleLove",
    "Audience": "CoupleLoveClient"
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "File", "Args": { "path": "logs/couple-.log", "rollingInterval": "Day" } },
      { "Name": "Console" }
    ]
  },
  "TokenStore": {
    "Provider": "Redis",
    "Configuration": "127.0.0.1:6379",
    "KeyPrefix": "auth:rt:"
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "EnableSsl": true,
    "FromAddress": "noreply@our-little-world.app",
    "FromName": "我们的小世界"
  }
}
