# 复制本文件为 .env 并修改密码后再执行 docker compose up
# 用法：cp .env.example .env

# MySQL（mysql 容器会据此自动建库 couple_love + 授权用户 app）
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=app
MYSQL_PASSWORD=change_me_app_password

# Redis：容器间经服务名 redis:6379 通信，无需配置。
# JWT RSA 私钥：使用仓库内已生成的 ./secrets/jwt-private.pem，由 compose 挂载，无需在此填写。
